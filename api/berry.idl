# BerryAPI script API definition (single source of truth).
#
# One IDL drives everything: the C++ binding table, TypeScript and Luau type
# definitions, and the reference docs. Editing this file and running
#
#     make idl
#
# regenerates include/berry/generated_bindings.h and generated/*. Editing the
# generated files by hand is a mistake: `make idl-check` fails the build when
# they drift from this description.
#
# Grammar (line oriented):
#   module <Name> {            open a module; functions inherit its capability
#   capability <cap>           default capability for the module's functions
#   doc "..."                  documentation for the next declaration
#   fn <name>(a: t, ...) -> t  a native binding
#   event <name>(a: t, ...)    an event channel scripts may await
#   struct <Name> { f: t ... } a value shape
#
# Types: nil, bool, number, string, Actor, Vec3, Rgba, Widget, Task, HttpResult,
#        Table (a structured value: a table/object of named fields)

module Combat {
  capability combat
  doc "Read-only combat telemetry. Writes go through the intent layer."
  fn recent_kills() -> number
  fn last_hit_damage() -> number
  fn observe(ticks: number) -> number
}

module Player {
  capability world
  doc "Read-only view of the LOCAL player. This is the client's own state, which it already holds; nothing here reveals another player. Reads fail closed when the local player is not bound."
  fn position() -> Vec3
  fn rotation() -> Vec3
  fn velocity() -> Vec3
  fn health() -> number
  fn max_health() -> number
  fn alive() -> bool
  fn name() -> string
  doc "Food level, 0..20. -1 when the local player is not bound."
  fn hunger() -> number
  doc "The hidden saturation value. -1 when the local player is not bound."
  fn saturation() -> number
  doc "Total armour points, 0..20."
  fn armor() -> number
  doc "The gamemode as a name: \"survival\", \"creative\", \"adventure\", \"spectator\" or \"unknown\"."
  fn gamemode() -> string
  doc "The dimension as a name: \"overworld\", \"nether\", \"end\" or \"unknown\"."
  fn dimension() -> string
  doc "The experience level."
  fn xp_level() -> number
  doc "Progress toward the next level, 0..1."
  fn xp_progress() -> number
  doc "Remaining breath in ticks (300 = full)."
  fn air() -> number
  doc "True while the local player is on fire."
  fn on_fire() -> bool
  doc "True while the local player is sneaking."
  fn sneaking() -> bool
  doc "True while the local player is sprinting."
  fn sprinting() -> bool
  doc "Active status effects as a table keyed \"0\",\"1\",…, each {name, amplifier, seconds, ambient}. Empty when none or the local player is unbound."
  fn effects() -> Table
  doc "The whole local-player state as one table: {hunger, saturation, armor, gamemode, dimension, xp_level, xp_progress, air, on_fire, sneaking, sprinting, effects}. Raises and returns nil when the local player is not bound."
  fn state() -> Table
}

module Render {
  capability render
  doc "Client-side drawing. Everything here is local to this screen. The 2D helpers take pixels; the 3D helpers take world coordinates and project through the current camera, so a script can draw an ESP-style overlay without knowing the projection matrix. Clipping is a nested scissor stack: `push_clip_rect` narrows the active clip (a child can only shrink its parent) and `pop_clip_rect` restores it. Rectangles and lines are clipped exactly; text and circles are kept while any part of them intersects the clip and dropped only when they fall entirely outside."
  fn draw_text(x: number, y: number, text: string, color: Rgba) -> nil
  fn draw_text_centered(x: number, y: number, text: string, color: Rgba) -> nil
  fn draw_rect(x: number, y: number, w: number, h: number, color: Rgba) -> nil
  fn draw_line(x1: number, y1: number, x2: number, y2: number, color: Rgba) -> nil
  fn draw_circle(x: number, y: number, radius: number, color: Rgba) -> nil
  fn screen_size() -> Vec3
  fn set_zoom(factor: number) -> nil
  doc "Projects a world point to pixels through the current camera. Returns {visible, x, y, distance}: `visible` is false when the point is behind the camera or no camera is set, so a caller checks it before drawing. `distance` is the world distance from the camera eye."
  fn world_to_screen(x: number, y: number, z: number) -> Table
  doc "Draws a world-space line. Clipped against the active clip rectangle; dropped when an endpoint is behind the camera."
  fn draw_3d_line(x1: number, y1: number, z1: number, x2: number, y2: number, z2: number, color: Rgba) -> nil
  doc "Draws the 12 edges of an axis-aligned world box from (min) to (max)."
  fn draw_3d_box(min_x: number, min_y: number, min_z: number, max_x: number, max_y: number, max_z: number, color: Rgba) -> nil
  doc "Draws text anchored at a world position. Nothing is drawn when the point is behind the camera or outside the active clip."
  fn draw_3d_text(x: number, y: number, z: number, text: string, color: Rgba) -> nil
  doc "Pushes a clip rectangle, intersected with the current top so a child clip can only narrow its parent. Bounded to 32 levels; a push past the cap is ignored rather than growing the stack."
  fn push_clip_rect(x: number, y: number, w: number, h: number) -> nil
  doc "Pops the innermost clip rectangle. An unmatched pop is a no-op."
  fn pop_clip_rect() -> nil
  doc "The active clip rectangle as {active, x, y, w, h}; `active` is false when no clip is pushed."
  fn clip_rect() -> Table
  doc "The camera the renderer last drew with, as {valid, x, y, z, yaw, pitch}. `valid` is false until a camera is bound."
  fn camera() -> Table
}

module World {
  capability world
  doc "Read-only world queries. The core never hands out raw pointers. `entities_within` returns a table keyed \"0\",\"1\",… each an entity table (id, type, x, y, z, health, alive, distance), sorted by id so the order is stable across ticks; a `type` of \"\" or \"any\" matches every type, and an unknown type name is refused rather than matching everything. The raycast helpers cast from the local player's eye along its look direction and return {hit, x, y, z, block, id, distance}. The biome/light/chunk reads take a block coordinate and fail closed (\"\", -1, \"unloaded\") when the seam has no answer."
  fn query(within: number) -> number
  fn entity_count() -> number
  fn block_at(x: number, y: number, z: number) -> number
  fn time() -> Table
  fn is_day() -> bool
  fn is_raining() -> bool
  fn entities_within(within: number, type: string) -> Table
  fn raycast_block(max_dist: number) -> Table
  fn raycast_entity(max_dist: number) -> Table
  doc "Every entity whose AABB overlaps the axis-aligned box from (min_x,min_y,min_z) to (max_x,max_y,max_z), as a table keyed \"0\",\"1\",… each an entity table. `type` filters as in `entities_within`. A box whose min exceeds its max is refused."
  fn entities_in_aabb(min_x: number, min_y: number, min_z: number, max_x: number, max_y: number, max_z: number, type: string) -> Table
  doc "Every entity within `radius` of a point, as a table keyed \"0\",\"1\",… each an entity table. `type` filters as in `entities_within`."
  fn entities_in_radius(x: number, y: number, z: number, radius: number, type: string) -> Table
  doc "Casts a ray from an arbitrary origin along a direction (not the local player's look), returning {hit, x, y, z, block, id, distance}. `dir_x`/`dir_y`/`dir_z` need not be normalized; a zero-length direction is refused. `target` is \"block\", \"entity\" or \"any\"."
  fn raycast(origin_x: number, origin_y: number, origin_z: number, dir_x: number, dir_y: number, dir_z: number, max_dist: number, target: string) -> Table
  doc "The biome name at a block coordinate, or \"\" when the seam has no answer."
  fn get_biome(x: number, y: number, z: number) -> string
  doc "The light level (0..15) at a block coordinate, or -1 when the seam has no answer."
  fn get_light(x: number, y: number, z: number) -> number
  doc "The load state of the chunk containing a block coordinate: \"unloaded\", \"loaded\" or \"rendered\"."
  fn get_chunk_state(x: number, y: number, z: number) -> string
  doc "The numeric block id at integer coordinates (0 = air). Alias of `block_at`, spelled to make the numeric return obvious."
  fn block_id_at(x: number, y: number, z: number) -> number
}

module Entity {
  capability world
  doc "Read-only access to one entity by its raw id, plus neighbourhood lookups. Nothing here mutates an entity; the id is the raw engine id an entity table or an event carries. Reads fail closed (a zero id, an unknown id, or an unbound seam) rather than fabricating state."
  fn get(id: number) -> Table
  fn type_name(id: number) -> string
  fn position(id: number) -> Vec3
  fn velocity(id: number) -> Vec3
  fn health(id: number) -> number
  fn alive(id: number) -> bool
  fn distance_to(id: number) -> number
  doc "The raw id of the nearest alive entity of `type` to the local player, or 0 when none is in range. An unknown type name is refused (fails closed) rather than returning an arbitrary entity."
  fn nearest(type: string) -> number
  doc "The entity's axis-aligned bounding box as {valid, min_x, min_y, min_z, max_x, max_y, max_z}. `valid` is false when the entity is not present. The box is derived from the entity's position and type (a fixed per-type size), never from engine memory."
  fn get_hitbox(id: number) -> Table
  doc "Casts a ray from (origin_x,origin_y,origin_z) along a direction and reports whether it reaches this entity's hitbox: {hit, distance, x, y, z}. A zero-length direction or a non-positive max distance is refused."
  fn trace_line(id: number, origin_x: number, origin_y: number, origin_z: number, dir_x: number, dir_y: number, dir_z: number, max_dist: number) -> Table
}

module Fs {
  capability fileio
  doc "Sandboxed file store. A script gets its own directory and nothing else: a path is validated before use (no absolute path, no backslash, no drive letter, no control character, no empty segment, no \".\" or \"..\", a bounded length and depth), so a path cannot escape the sandbox however it is spelled. Writes are capped per file, in total and in count, so a write loop cannot exhaust memory. Every call fails closed (false / empty) rather than throwing."
  fn write(path: string, data: string) -> bool
  fn read(path: string) -> string
  fn append(path: string, data: string) -> bool
  fn exists(path: string) -> bool
  fn remove(path: string) -> bool
  fn size(path: string) -> number
  doc "Every path in the sandbox, sorted, newline-separated. `prefix` filters to paths that start with it; an empty prefix lists everything."
  fn list(prefix: string) -> string
  fn count() -> number
  fn total_bytes() -> number
  fn clear() -> nil
}

module Audio {
  capability audio
  doc "Client-side sound cues. A script plays a named cue; the device backend decides what the name means. This is a sound the local player hears, so nothing here is authoritative. An unknown or malformed cue name is refused, and a muted play is dropped rather than queued. Volume and pitch are clamped into range."
  fn play(name: string, volume: number, pitch: number) -> bool
  fn set_volume(volume: number) -> nil
  fn volume() -> number
  fn set_muted(muted: bool) -> nil
  fn muted() -> bool
  doc "The recent cues that would have played, newest last, newline-separated as \"name:volume:pitch\"."
  fn history() -> string
  fn history_count() -> number
  fn clear_history() -> nil
}

module Pvp {
  capability hud
  doc "The PvP overlay: the client-side read-outs a normal client could already see — CPS, keystrokes, a combo counter, armor/durability, active effects, ping/TPS/FPS, the current target and rolling session stats. All local, all read-only; nothing here reveals another player beyond what a fight already shows, and nothing writes game state. `session` returns {damage_dealt, damage_taken, kills, deaths, hits, peak_dps, kd}; `armor` and `effects` are tables keyed \"0\",\"1\",… ; `net` returns {ping_ms, tps, fps}; `target` returns {name, health, max_health, distance, armor, valid}."
  doc "The clicks-per-second for \"left\" or \"right\", from the same rolling window the CPS widget reads."
  fn cps(button: string) -> number
  fn combo() -> number
  fn combo_active() -> bool
  fn session() -> Table
  fn armor() -> Table
  fn effects() -> Table
  fn net() -> Table
  fn target() -> Table
  fn health() -> number
  fn max_health() -> number
  doc "Turns overlay sections on and off. `flags` is a newline-separated list of enabled keys from: cps, keystrokes, combo, armor, effects, net, target, session, popups, hitflash, vignette. A key that is not in the list is turned off, so the call fully describes the config; an unknown key is refused (fail closed) and leaves the config unchanged."
  fn set_config(flags: string) -> bool
  doc "The enabled section keys, newline-separated, in a stable order."
  fn config() -> string
  fn attach() -> bool
  fn detach() -> nil
  fn attached() -> bool
  doc "True while the local player is under the low-health threshold and the vignette is on."
  fn low_health() -> bool
}

module Packets {
  capability packets
  doc "Read-only packet inspection. The log holds packet METADATA only — a sequence number, direction, protocol id, a name and a byte length — and never payload bytes, so it cannot become a collection surface. It answers the diagnostic questions (am I being spammed, is this id new since the update, how much am I sending) without exposing anyone's data. Fed by the network layer; a script only reads it. `recent` returns a table keyed \"0\",\"1\",…, newest first, each {seq, dir, id, name, bytes, time_ms}; `summary` is the same shape per id, highest count first. `dir` is \"inbound\", \"outbound\" or \"\" for both."
  fn recent(max: number) -> Table
  fn last() -> Table
  fn totals() -> Table
  fn summary(dir: string) -> Table
  fn count_of(id: number) -> number
  fn size() -> number
  fn clear() -> nil
}

module Mod {
  capability hud
  doc "Script module + settings system. A script declares a module with metadata and a set of TYPED settings (toggle, slider, select, keybind, text, button); the client renders them and the user configures them. Every write is validated against the setting's declared kind and range and fails closed, so a toggle can never receive an out-of-range slider value. Handles are numbers; a setting is addressed by its module handle and key. `options` for a select is a newline-separated list of labels."
  fn create(name: string, description: string) -> number
  doc "Sets a module's version and author after creation. Fails closed on an unknown handle."
  fn set_meta(handle: number, version: string, author: string) -> bool
  fn add_toggle(handle: number, key: string, label: string, default: bool) -> bool
  fn add_slider(handle: number, key: string, label: string, min: number, max: number, default: number) -> bool
  fn add_select(handle: number, key: string, label: string, options: string, default: number) -> bool
  fn add_keybind(handle: number, key: string, label: string, default: string) -> bool
  fn add_text(handle: number, key: string, label: string, default: string) -> bool
  fn add_button(handle: number, key: string, label: string) -> bool
  fn set_number(handle: number, key: string, value: number) -> bool
  fn set_text(handle: number, key: string, value: string) -> bool
  doc "Raises a button setting's one-shot press. The next `mod.get` / `mod.number` read consumes it."
  fn press(handle: number, key: string) -> bool
  fn number(handle: number, key: string) -> number
  fn text(handle: number, key: string) -> string
  fn enabled(handle: number) -> bool
  fn set_enabled(handle: number, on: bool) -> bool
  fn count() -> number
  doc "One setting as a table: {key, label, kind, number, text, pressed, min, max, options}."
  fn get(handle: number, key: string) -> Table
  doc "A module's metadata and its settings as a table: {handle, name, description, version, author, enabled, count, settings}."
  fn info(handle: number) -> Table
  fn list() -> string
  fn settings(handle: number) -> string
  fn clear() -> nil
  fn set_overlay(on: bool) -> nil
  fn overlay() -> bool
}

module Network {
  capability network
  doc "Outbound requests. Requires a network grant scoped to the host. Both calls return an HttpResult table (status, ok, headers, body, error, truncated) rather than raising, so a script can branch on the outcome; headers is a newline-separated \"Name: value\" list. A refused destination (bad URL, egress policy, or a host outside the grant) comes back with status 0 and a non-empty error. TLS is not implemented, so an https destination is refused rather than downgraded to plaintext."
  fn get(url: string, timeout_ms: number) -> HttpResult
  fn post(url: string, body: string, timeout_ms: number) -> HttpResult
}

module Ws {
  capability network
  doc "WebSocket client. Requires a network grant scoped to the host, and the same egress policy `network.get` uses: a ws:// URL to a private or reserved host is refused, and wss:// fails closed because TLS is not implemented. A connection is addressed by an integer handle; the frames a peer sends are buffered in order and read with `ws.poll` after `ws.pump`. Every call runs on the script worker (blocking reads are expected there). `ws.connect` returns 0 and raises on a refused destination or a failed handshake. `ws.poll` returns {ok, opcode, data, binary}; `ok` is false when the inbox is empty."
  fn connect(url: string, timeout_ms: number) -> number
  fn send_text(handle: number, text: string) -> bool
  fn send_binary(handle: number, data: string) -> bool
  doc "Reads any pending frames for every open handle into their inboxes. Returns how many frames were read."
  fn pump() -> number
  doc "Pops the oldest buffered frame for `handle`. `ok` is false when the inbox is empty or the handle is unknown."
  fn poll(handle: number) -> Table
  fn pending(handle: number) -> number
  fn is_open(handle: number) -> bool
  fn close(handle: number) -> bool
  fn count() -> number
  doc "The URL a handle was opened with, or \"\" when the handle is unknown."
  fn url(handle: number) -> string
}

module JsonRpc {
  capability network
  doc "JSON-RPC 2.0 client. Issues one call over the same egress-checked HTTP path as `network.post`, so the destination rules are identical. The response is validated as JSON-RPC 2.0 and its id must match before the result is trusted. `call` returns {ok, result, error_code, error_message, status}: `result` is a structured table decoded from the reply's `result` member, and a transport failure (bad URL, refused destination, HTTP status, malformed envelope) comes back with `ok` false and `error_message` set, so a script branches on the outcome rather than unwinding. `params_json` is raw JSON (an object or array); an empty string omits `params`."
  fn call(url: string, method: string, params_json: string, timeout_ms: number) -> Table
}

module Hud {
  capability hud
  doc "Retained-mode HUD widget tree."
  fn create_label(text: string) -> Widget
  fn create_panel(x: number, y: number) -> Widget
  fn attach(widget: Widget) -> nil
  fn set_visible(widget: Widget, visible: bool) -> nil
  fn tween(widget: Widget, prop: string, to: number, ms: number) -> nil
}

module Perf {
  capability perf
  doc "Frame timing and quality controls."
  fn frame_time_ms() -> number
  fn stats() -> Table
  fn quality() -> number
  fn set_target_fps(fps: number) -> nil
  fn set_thermal_mode(enabled: bool) -> nil
  doc "Select the device profile the governor tunes itself for: generic, mobile-low, mobile-high or desktop. Unknown names are refused (fail closed)."
  fn set_platform(name: string) -> nil
  doc "The aggregated span call tree since the last `perf.flame_reset`, as a nested table: each node is {name, self_ms, total_ms, count, children}, and `children` is ordered by total time descending so the expensive branch reads first. `self_ms` excludes child spans, so a parent's `total_ms` is the time actually spent inside it. Populated by the profiler spans the modules and hooks raise."
  fn flame() -> Table
  doc "The flat span list, highest total time first: a table keyed \"0\",\"1\",… each {name, total_ms, count, max_ms}. The list view of the same data `flame` nests."
  fn spans() -> Table
  doc "Drops the flame tree, the span stats and the per-frame ring, starting the profiler over."
  fn flame_reset() -> nil
}

module Input {
  capability input
  doc "Client-side input state. Values a normal client could already see."
  fn is_key_down(key: string) -> bool
  fn clicks_per_second() -> number
  doc "The local player's core velocity (motionX/Y/Z, blocks/second). Zero when stationary or unknown; drives trailing cosmetic sway."
  fn velocity() -> Vec3
}

module Cosmetic {
  capability cosmetic
  doc "Local cosmetic loadouts. Renders on this screen only unless the sync channel is on."
  fn list() -> string
  fn equipped(slot: string) -> string
  fn equip(asset: string) -> bool
  fn unequip(slot: string) -> bool
  fn save_preset(name: string) -> bool
  fn apply_preset(name: string) -> bool
  fn presets() -> string
  fn set_local_only(enabled: bool) -> nil
  doc "Reload local model packs from the pack directory, registering every valid *.pack.json. Returns the number of packs loaded; each pack is applied atomically (all its assets or none)."
  fn reload_packs() -> number
}

module Events {
  capability events
  doc "Event channels scripts may await with Events.once. The world-diff channels are driven by the reactive world grid: entityEntered and entityLeft carry \"<id>:<type>\", entityUpdated fires when an entity's position, health or state changed between ticks, and blockChanged carries \"x,y,z,block\". A script never polls for these. The lifecycle channels (entityHurt, entityDeath, entitySpawn) are driven by the combat bus and the world diff and carry \"<id>:<detail>\" (entityHurt's detail is the damage, entitySpawn's is the type), so a script can filter by id without a parser."
  event hit(damage: number)
  event kill(victim: string)
  event tick_count(count: number)
  event entityEntered(entity: string)
  event entityLeft(entity: string)
  event entityUpdated(entity: string)
  event blockChanged(change: string)
  event entityHurt(entity: string)
  event entityDeath(entity: string)
  event entitySpawn(entity: string)
}

module Intent {
  capability input
  doc "Intent layer. A script does not mutate the world; it requests an intent and a policy layer validates it. Client-side intents (zoom, freelook, fov, perspective, keybind, hud, nametag, cosmetic, sound) are what normal player input could do or what stays on this screen. World writes are denied. A server policy profile can disable whole groups on servers that ban client mods. This module is the read side: query what is allowed here. It carries the input grant, the capability the client-side intent groups share."
  fn allowed(name: string) -> bool
  fn classify(name: string) -> string
  fn server() -> string
  fn profile() -> string
  fn disabled_groups() -> string
  fn list() -> string
}

module Shader {
  capability render
  doc "Script-registered GLES fragment shaders and the post-process chain. Registration is validated before any GL call, so a malformed or oversized shader is refused without touching the device. Reloading a shader by re-registering its name keeps its chain position and the parameters whose uniforms survive, and a shader the device refuses leaves the previous program in place."
  fn register(name: string, source: string) -> bool
  fn unregister(name: string) -> bool
  fn has(name: string) -> bool
  fn list() -> string
  fn uniforms(name: string) -> string
  fn enable(name: string, on: bool) -> bool
  fn chain() -> string
  fn set_param(name: string, param: string, value: number) -> bool
  fn param(name: string, param: string) -> number
  fn clear() -> nil
}

module Package {
  capability fileio
  doc "Script package registry and resolver. A package is a JSON manifest plus an entry file; a script declares dependencies with version constraints. Semver is parsed (1.10.0 sorts above 1.9.0, a pre-release below its release) and caret/tilde constraints are normalised at parse time. Resolution picks one version per package and orders them dependencies-first; it fails closed on a missing package, an unsatisfiable constraint, a conflict or a cycle. This module carries the fileio grant: it names packages that live on disk, even though resolution itself is pure."
  fn add(manifest_json: string) -> bool
  fn has(name: string) -> bool
  fn versions(name: string) -> string
  fn resolve(name: string, constraint: string) -> string
  fn require_path(path: string) -> string
  fn clear() -> nil
}

module Record {
  capability world
  doc "Record & replay of this client's world stream. `start` begins capturing one frame per tick — the level time, every entity the world grid already read, and the entered/left/updated transitions — into an in-memory tape; `stop` ends the session and keeps the tape. `save` returns the tape as one JSON document and `load` replaces the tape from one (rejecting the whole document on any error). `replay_*` drives a replay seam that answers the world queries from the tape instead of the game, so a script can be regression-tested with no game running. Recording reads the world read-only and never writes to it; a tape is what this client saw, a debugging aid, not a network protocol."
  doc "Begins a fresh recording, clearing any previous tape. False when already recording."
  fn start() -> bool
  doc "Ends the session and keeps the tape. False when not recording."
  fn stop() -> bool
  fn recording() -> bool
  doc "The number of frames on the tape."
  fn frames() -> number
  doc "True when a capture hit a cap and dropped data."
  fn overflowed() -> bool
  doc "The tape as one JSON document, ready to save or attach to a bug report."
  fn save() -> string
  doc "Replaces the tape from a JSON document. Rejects the whole document on any error and leaves the current tape untouched."
  fn load(json: string) -> bool
  fn clear() -> nil
  doc "Advances the replay one frame. False at the end of the tape."
  fn replay_step() -> bool
  fn replay_seek(index: number) -> bool
  fn replay_rewind() -> nil
  doc "The tick of the current replay frame, or 0 when there is none."
  fn replay_tick() -> number
  doc "The current replay frame index, or -1 before the first step."
  fn replay_index() -> number
  fn replay_end() -> bool
}
