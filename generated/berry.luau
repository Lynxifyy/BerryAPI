  dummy: (w: number, h: number) -> (),
  -- Indents subsequent widgets by one level.
  indent: () -> (),
  -- Reverses one level of indent.
  unindent: () -> (),
  -- A bulleted line.
  bullet_text: (text: string) -> (),
  -- Selects the theme: \"dark\" (the default, flat) or \"glass\" (translucent, rounded, iOS-style). An unknown name is refused (fail closed) and the theme is unchanged.
  set_theme: (name: string) -> boolean,
  -- The active theme's name.
  theme: () -> string,
  -- The layer's counters as {frames, windows, widgets, hovered, clicked}.
  stats: () -> {[string]: any},
  -- True while any window is being dragged, so a caller can suppress camera input.
  any_window_dragging: () -> boolean,
  -- Drops every window's persistent state (drag offsets, scroll, collapse).
  reset: () -> (),
}

-- Capability required: perf.
export type Perf = {
  -- Frame timing and quality controls.
  frame_time_ms: () -> number,
  stats: () -> {[string]: any},
  quality: () -> number,
  set_target_fps: (fps: number) -> (),
  set_thermal_mode: (enabled: boolean) -> (),
  -- Select the device profile the governor tunes itself for: generic, mobile-low, mobile-high or desktop. Unknown names are refused (fail closed).
  set_platform: (name: string) -> (),
  -- The aggregated span call tree since the last `perf.flame_reset`, as a nested table: each node is {name, self_ms, total_ms, count, children}, and `children` is ordered by total time descending so the expensive branch reads first. `self_ms` excludes child spans, so a parent's `total_ms` is the time actually spent inside it. Populated by the profiler spans the modules and hooks raise.
  flame: () -> {[string]: any},
  -- The flat span list, highest total time first: a table keyed \"0\",\"1\",… each {name, total_ms, count, max_ms}. The list view of the same data `flame` nests.
  spans: () -> {[string]: any},
  -- Drops the flame tree, the span stats and the per-frame ring, starting the profiler over.
  flame_reset: () -> (),
  -- The render pipeline's frame counters as {frames, entities_submitted, entities_drawn, entities_culled, entities_lod_reduced, batches, draw_calls, vertices, resolution_scale}. `draw_calls` counts the two coalesced calls (triangles + lines) a frame issues, so it stays flat however many primitives a script queued; `resolution_scale` is the factor the dynamic-resolution controller settled on (1.0 is native).
  pipeline: () -> {[string]: any},
  -- The level-of-detail tier an entity `distance` blocks from the camera would be drawn at: \"full\", \"reduced\", \"static\" or \"culled\". Follows the same policy the renderer culls with, so a script can predict whether its overlay will be given geometry.
  lod_tier: (distance: number) -> string,
  -- Whether an entity `distance` blocks away should advance its animation/physics on `tick`, keyed by `phase` (pass the entity id so a crowd does not all update on one tick). True every tick at \"full\", one tick in the policy's reduced interval at \"reduced\", never at \"static\"/\"culled\". This is the tick-rate half of LOD: a script that drives a crowd skips a false result to throttle it.
  lod_should_tick: (distance: number, tick: number, phase: number) -> boolean,
}

-- Capability required: input.
export type Input = {
  -- Client-side input state. Values a normal client could already see.
  is_key_down: (key: string) -> boolean,
  clicks_per_second: () -> number,
  -- The local player's core velocity (motionX/Y/Z, blocks/second). Zero when stationary or unknown; drives trailing cosmetic sway.
  velocity: () -> Vec3,
}

-- Capability required: cosmetic.
export type Cosmetic = {
  -- Local cosmetic loadouts. Renders on this screen only unless the sync channel is on.
  list: () -> string,
  equipped: (slot: string) -> string,
  equip: (asset: string) -> boolean,
  unequip: (slot: string) -> boolean,
  save_preset: (name: string) -> boolean,
  apply_preset: (name: string) -> boolean,
  presets: () -> string,
  set_local_only: (enabled: boolean) -> (),
  -- Reload local model packs from the pack directory, registering every valid *.pack.json. Returns the number of packs loaded; each pack is applied atomically (all its assets or none).
  reload_packs: () -> number,
  -- How many peers the client's LAN discovery has found this session, most recently seen first. 0 when discovery is off (the client was not configured to sync). Discovery only names peers — a loadout from one is still verified by the sync channel before anything is applied.
  peers: () -> number,
  -- The discovered peer at `index`, most recently seen first, as {instance, address, port, last_ms}, or an empty table when out of range.
  peer: (index: number) -> {[string]: any},
  -- This client's cosmetic-sync channel counters as {accepted, rejected, peers, replay_window, configured}, or zeros with configured=false when sync is off.
  sync_stats: () -> {[string]: any},
}

-- Capability required: cosmetic.
export type Animator = {
  -- Adds an empty clip. False when the name is empty/too long/already used, the duration is not finite and positive, or the clip cap is reached.
  add_clip: (name: string, duration: number, looping: boolean) -> boolean,
  -- Appends a keyframe to a clip. False when the clip is unknown, the bone is unknown, the time is negative or past the duration, the scale is not finite and positive, or the per-clip key cap is reached. `position`/`rotation` are offsets from the bone's rest transform (rotation in degrees).
  add_key: (clip: string, bone: string, time: number, px: number, py: number, pz: number, rx: number, ry: number, rz: number, scale: number) -> boolean,
  -- Removes a clip. False when it is unknown.
  remove_clip: (name: string) -> boolean,
  -- Removes every key from a clip, keeping the clip. False when unknown.
  clear_clip: (name: string) -> boolean,
  clip_count: () -> number,
  has_clip: (name: string) -> boolean,
  -- The number of keys in a clip, or 0 when unknown.
  key_count: (name: string) -> number,
  -- Starts a clip from time 0. False when the clip is unknown.
  play: (name: string) -> boolean,
  -- Stops playback, leaving the current time where it is.
  stop: () -> (),
  -- Stops and rewinds to time 0.
  reset: () -> (),
  playing: () -> boolean,
  -- The current play time in seconds.
  time: () -> number,
  -- The current clip's duration, or 0 when none is selected.
  duration: () -> number,
  -- The current clip's name, or \"\" when none is selected.
  current_clip: () -> string,
  -- Jumps to an absolute time within the current clip, clamped/wrapped the same way playback would land there. False when no clip is selected.
  seek: (seconds: number) -> boolean,
  -- A bone's interpolated pose at an absolute time within the current clip, as {valid, bone, px, py, pz, rx, ry, rz, scale}. `valid` is false when no clip/bone has a key there.
  sample: (bone: string, time: number) -> {[string]: any},
  -- The whole current pose: one table per bone that has a key in the current clip, at the current time, each {bone, px, py, pz, rx, ry, rz, scale}. Empty when no clip is selected.
  pose: () -> {[string]: any},
  -- The clips as one JSON document (deterministic: same clips, same bytes).
  save: () -> string,
  -- Replaces the clips from a JSON document in the exact format `save` returns, including its version. Rejects the whole document on any error (malformed JSON, the wrong format or version, a duplicate name, an unknown bone, an out-of-range key) and leaves the current clips untouched. Playback is stopped.
  load: (json: string) -> boolean,
  -- Drops every clip and stops playback.
  clear: () -> (),
  -- The entity the animator drives (0 = every entity the skeleton seam resolves).
  target: () -> number,
  -- Sets the entity the animator drives. 0 animates every entity the base skeleton seam resolves.
  set_target: (entity: number) -> (),
}

-- Capability required: input.
export type Intent = {
  -- Intent layer. A script does not mutate the world; it requests an intent and a policy layer validates it. Client-side intents (zoom, freelook, fov, perspective, keybind, hud, nametag, cosmetic, sound) are what normal player input could do or what stays on this screen. World writes are denied. A server policy profile can disable whole groups on servers that ban client mods. This module is the read side: query what is allowed here. It carries the input grant, the capability the client-side intent groups share.
  allowed: (name: string) -> boolean,
  classify: (name: string) -> string,
  server: () -> string,
  profile: () -> string,
  disabled_groups: () -> string,
  list: () -> string,
}

-- Capability required: render.
export type Shader = {
  -- Script-registered GLES fragment shaders and the post-process chain. Registration is validated before any GL call, so a malformed or oversized shader is refused without touching the device. Reloading a shader by re-registering its name keeps its chain position and the parameters whose uniforms survive, and a shader the device refuses leaves the previous program in place.
  register: (name: string, source: string) -> boolean,
  unregister: (name: string) -> boolean,
  has: (name: string) -> boolean,
  list: () -> string,
  uniforms: (name: string) -> string,
  enable: (name: string, on: boolean) -> boolean,
  chain: () -> string,
  set_param: (name: string, param: string, value: number) -> boolean,
  param: (name: string, param: string) -> number,
  clear: () -> (),
}

-- Capability required: fileio.
export type Package = {
  -- Script package registry and resolver. A package is a JSON manifest plus an entry file; a script declares dependencies with version constraints. Semver is parsed (1.10.0 sorts above 1.9.0, a pre-release below its release) and caret/tilde constraints are normalised at parse time. Resolution picks one version per package and orders them dependencies-first; it fails closed on a missing package, an unsatisfiable constraint, a conflict or a cycle. This module carries the fileio grant: it names packages that live on disk, even though resolution itself is pure.
  add: (manifest_json: string) -> boolean,
  has: (name: string) -> boolean,
  versions: (name: string) -> string,
  resolve: (name: string, constraint: string) -> string,
  require_path: (path: string) -> string,
  clear: () -> (),
}

-- Capability required: world.
export type Record = {
  -- Begins a fresh recording, clearing any previous tape. False when already recording.
  start: () -> boolean,
  -- Ends the session and keeps the tape. False when not recording.
  stop: () -> boolean,
  recording: () -> boolean,
  -- The number of frames on the tape.
  frames: () -> number,
  -- True when a capture hit a cap and dropped data.
  overflowed: () -> boolean,
  -- The tape as one JSON document, ready to save or attach to a bug report.
  save: () -> string,
  -- Replaces the tape from a JSON document. Rejects the whole document on any error and leaves the current tape untouched.
  load: (json: string) -> boolean,
  clear: () -> (),
  -- Advances the replay one frame. False at the end of the tape.
  replay_step: () -> boolean,
  replay_seek: (index: number) -> boolean,
  replay_rewind: () -> (),
  -- The tick of the current replay frame, or 0 when there is none.
  replay_tick: () -> number,
  -- The current replay frame index, or -1 before the first step.
  replay_index: () -> number,
  replay_end: () -> boolean,
}

-- Capability required: world.
export type Replay = {
  -- Adds a camera key at a tick. False when the position or angles are not finite, the FOV is outside [1, 179], the key cap is reached, or a key already exists at that tick (remove it first).
  add_key: (tick: number, x: number, y: number, z: number, pitch: number, yaw: number, roll: number, fov: number) -> boolean,
  -- Removes the key at a tick. False when there is none.
  remove_key: (tick: number) -> boolean,
  -- Drops every key and stops playback. Keeps whether the timeline is active.
  clear: () -> (),
  key_count: () -> number,
  has_key: (tick: number) -> boolean,
  -- The first key's tick, or 0 when there are no keys.
  first_tick: () -> number,
  -- The last key's tick, or 0 when there are no keys.
  last_tick: () -> number,
  -- The span between the first and last key, or 0 with fewer than two keys.
  duration_ticks: () -> number,
  -- The interpolation mode, \"linear\" or \"smooth\".
  smoothing: () -> string,
  -- Sets the interpolation mode. False when the name is neither \"linear\" nor \"smooth\".
  set_smoothing: (name: string) -> boolean,
  -- True when the frame's camera is driven by this timeline.
  active: () -> boolean,
  -- Hands the frame's camera to this timeline (and starts playback). False when there are no keys to play.
  activate: () -> boolean,
  -- Gives the camera back to the player and pauses.
  deactivate: () -> (),
  -- Starts (or resumes) playback from the current playhead. False when there are no keys.
  play: () -> boolean,
  pause: () -> (),
  -- Pauses and rewinds to the first key.
  stop: () -> (),
  playing: () -> boolean,
  -- True when the playhead follows the replay tape's tick instead of the frame clock. Off by default.
  follow_tape: () -> boolean,
  -- When on, the playhead is the replay tape's tick: a key at tick N shows at tick N of the recording, and the camera glides as the tape steps. When off, the playhead advances on the frame clock at `speed`.
  set_follow_tape: (on: boolean) -> (),
  speed: () -> number,
  -- Sets the playback speed multiplier. Must be finite and in (0, 64]; a bad value is refused.
  set_speed: (speed: number) -> boolean,
  -- The playhead in ticks (fractional, so it can fall between keys).
  playhead: () -> number,
  -- Moves the playhead, clamped into the key range. False when there are no keys.
  seek: (tick: number) -> boolean,
  -- The pose at an absolute tick as {valid, x, y, z, pitch, yaw, roll, fov}. Before the first key it holds the first, past the last it holds the last.
  sample: (tick: number) -> {[string]: any},
  -- The pose at the current playhead, same shape as `sample`.
  sample_now: () -> {[string]: any},
  -- The FOV override in degrees, or 0 when the keyframed FOV is used.
  fov_override: () -> number,
  -- Pins the FOV, or clears the pin with 0. A non-zero value must be finite and in [1, 179]; a bad value is refused.
  set_fov_override: (fov: number) -> boolean,
  -- Begins a fixed-rate export from the first key. False when the rate is not finite and in (0, 240], the viewport is not finite and positive, or there are no keys. While exporting, the client's frame hook yields one video frame per rendered frame at this rate — independent of the machine's real frame rate — so the export's length is a property of the timeline, not the renderer.
  export_begin: (fps: number, width: number, height: number) -> boolean,
  -- Ends an export. A no-op when none is running.
  export_end: () -> (),
  exporting: () -> boolean,
  -- How many frames the current export has yielded.
  export_frame: () -> number,
  -- The export frame rate, or 0 when not exporting.
  export_fps: () -> number,
}

-- Capability required: hud.
export type Radial = {
  -- Appends an item. False when the label is empty, longer than 32 bytes or non-printable, or the menu already holds its maximum of 12 items.
  add_item: (label: string, enabled: boolean) -> boolean,
  -- Removes the item at `index`. False when out of range.
  remove_item: (index: number) -> boolean,
  -- Removes every item and closes the menu.
  clear: () -> (),
  -- How many items the menu holds.
  count: () -> number,
  -- The label at `index`, or an empty string when out of range.
  item_label: (index: number) -> string,
  -- Whether the item at `index` is enabled; false when out of range.
  item_enabled: (index: number) -> boolean,
  -- Enables or disables an item. False when out of range.
  set_item_enabled: (index: number, enabled: boolean) -> boolean,
  -- Opens the menu. False when it holds no items (an empty menu is not worth showing) or is already open.
  open: () -> boolean,
  -- Closes the menu and clears the hover and selection.
  close: () -> (),
  -- True while the menu is open.
  is_open: () -> boolean,
  -- The outer radius in pixels.
  radius: () -> number,
  -- Sets the outer radius. Must be finite and positive and greater than the inner radius; a bad value is refused.
  set_radius: (radius: number) -> boolean,
  -- The inner (dead-zone) radius in pixels.
  inner_radius: () -> number,
  -- Sets the inner radius. Must be finite, non-negative and less than the outer radius; a bad value is refused.
  set_inner_radius: (radius: number) -> boolean,
  -- The open/close animation duration in milliseconds.
  open_ms: () -> number,
  -- Sets the open animation duration. Must be finite and positive; a bad value is refused.
  set_open_ms: (ms: number) -> boolean,
  -- The current menu state as {open, hovered, selected, progress, items}. `hovered`/`selected` are -1 when none.
  state: () -> {[string]: any},
  -- The sector under a pointer relative to a centre for `count` sectors, or -1 for the dead zone or outside the ring. Pure: it reads no state, so it pins the geometry.
  sector_at: (pointer_x: number, pointer_y: number, center_x: number, center_y: number, inner_radius: number, outer_radius: number, count: number) -> number,
}

-- Capability required: combat.
export type Crystal = {
  -- The current tunables as {place_range, blast_radius, max_damage, min_targets, self_damage_weight, max_self_damage, levels, max_results}.
  config: () -> {[string]: any},
  -- Sets the placement range in blocks. Must be finite, positive and at most 16; a bad value is refused.
  set_range: (range: number) -> boolean,
  -- Sets the blast radius in blocks. Must be finite, positive and at most 32; a bad value is refused.
  set_blast_radius: (radius: number) -> boolean,
  -- Sets the damage at the epicentre before falloff. Must be finite and non-negative; a bad value is refused.
  set_max_damage: (damage: number) -> boolean,
  -- Sets the minimum number of targets a spot must hit to be recommended. Must be a non-negative integer; a bad value is refused.
  set_min_targets: (n: number) -> boolean,
  -- Sets how heavily damage to the placer is weighted against damage to enemies. Must be finite and non-negative; a bad value is refused.
  set_self_damage_weight: (weight: number) -> boolean,
  -- Sets the most damage a recommended spot may deal to the placer. Must be finite and non-negative; a bad value is refused.
  set_max_self_damage: (damage: number) -> boolean,
  -- Sets the number of block levels above and below the placer's feet to consider. Must be an integer in [0, 4]; a bad value is refused.
  set_levels: (levels: number) -> boolean,
  -- Sets how many recommendations an analysis keeps. Must be an integer in [1, 4096]; a bad value is refused.
  set_max_results: (n: number) -> boolean,
  -- Ranks the candidate placements around a placer at (x, y, z) against the entities the world grid already read, and returns how many were recommended. Fails closed (returns 0) when the world or the advisor is unavailable. The ranking is available through `count` and `placement`.
  analyze: (x: number, y: number, z: number) -> number,
  -- How many recommendations the last analysis produced.
  count: () -> number,
  -- The best recommendation as {ok, x, y, z, targets, total_damage, best_damage, self_damage, score}. `ok` is false when there is none.
  best: () -> {[string]: any},
  -- The recommendation at `index` in the last ranking, same shape as `best`, or an empty table when out of range.
  placement: (index: number) -> {[string]: any},
  -- The estimated damage a blast at (x, y, z) would deal to a target at (tx, ty, tz) under the current tunables. Pure: it reads no world state.
  estimate: (x: number, y: number, z: number, tx: number, ty: number, tz: number) -> number,
  -- The advisor's counters as {analyses, candidates, placements, best_score}.
  stats: () -> {[string]: any},
  -- Forgets the last ranking and its counters.
  reset: () -> (),
  -- Arms the advisor. While armed, the client's tick hook runs one advisory pass per game tick around the local player and fires `crystalAdvice` when the best spot changes. False when it is already armed.
  arm: () -> boolean,
  -- Disarms the advisor. A no-op when it is already disarmed.
  disarm: () -> (),
  -- True while the advisor runs its advisory pass on the game tick.
  armed: () -> boolean,
}

-- Capability required: voice.
export type Voice = {
  -- The current tunables as {max_range, full_volume_range, master_volume, max_speakers, hold_ms, max_frame_bytes, min_send_interval_ms}.
  config: () -> {[string]: any},
  -- Sets how far a speaker is heard, in blocks. Must be finite and in (0, 128]; a bad value is refused.
  set_max_range: (range: number) -> boolean,
  -- Sets the distance within which a speaker plays at full volume. Must be finite and in [0, max_range]; a bad value is refused.
  set_full_volume_range: (range: number) -> boolean,
  -- Sets the playback master volume. Must be finite and in [0, 1]; a bad value is refused.
  set_master_volume: (volume: number) -> boolean,
  -- Sets how many speakers are mixed at once. Must be an integer in [1, 32]; a bad value is refused.
  set_max_speakers: (n: number) -> boolean,
  -- Sets how long a speaker stays listed as talking after its last frame, in ms. Must be a positive integer; a bad value is refused.
  set_hold_ms: (ms: number) -> boolean,
  -- Sets the largest inbound frame payload accepted, in bytes. Must be an integer in [1, 2048]; a bad value is refused.
  set_max_frame_bytes: (n: number) -> boolean,
  -- Sets the shortest gap between outgoing frames, in ms. Must be a positive integer; a bad value is refused.
  set_min_send_interval_ms: (ms: number) -> boolean,
  -- Starts a session as `self_id`. False when already running, when the id is malformed (empty, over 64 bytes, or carrying a control character), or when no transport is bound (there is nothing to talk over).
  start: (self_id: string) -> boolean,
  -- Stops the session and forgets the speakers. A no-op when not running.
  stop: () -> (),
  -- True while a session is running.
  running: () -> boolean,
  -- The local session id, or \"\" when not running.
  self_id: () -> string,
  -- Sets push-to-talk (or open-mic) state. Only a talking, unmuted session sends; the receive half runs either way.
  set_talking: (talking: boolean) -> (),
  -- True while the local client is sending.
  talking: () -> boolean,
  -- Sets the microphone mute. A muted session sends nothing.
  set_muted: (muted: boolean) -> (),
  -- True while the microphone is muted.
  muted: () -> boolean,
  -- Sets the local player's position, used to judge the proximity of what the listener hears.
  set_position: (x: number, y: number, z: number) -> (),
  -- How many speakers are currently heard.
  speaker_count: () -> number,
  -- The speaker at `index` in the activity list (loudest first) as {id, level, distance, last_ms}, or an empty table when out of range.
  speaker: (index: number) -> {[string]: any},
  -- The session counters as {frames_captured, frames_sent, frames_received, frames_dropped, frames_played, bytes_sent, bytes_received}.
  stats: () -> {[string]: any},
  -- Forgets the speaker state and the counters, keeping the config and the seams.
  reset: () -> (),
  -- The transport's short name (\"lan\" on device, \"\" when none is bound).
  transport: () -> string,
}

-- Capability required: world.
export type ReplayMod = {
  -- Begins a fresh capture, clearing any previous tape. False when already recording.
  capture_start: () -> boolean,
  -- Ends the capture and keeps the tape. False when not recording.
  capture_stop: () -> boolean,
  capturing: () -> boolean,
  -- The number of sections on the tape.
  section_count: () -> number,
  -- The uncompressed payload bytes currently held.
  bytes: () -> number,
  -- The first and last tick held, or 0 when empty.
  first_tick: () -> number,
  last_tick: () -> number,
  -- The tape as one binary replay document, ready to save. Returns \"\" on a write error.
  save: () -> string,
  -- Replaces the loaded replay from a binary document. Rejects the whole document on any error (returns false with a reason in `last_error`) and leaves the current replay untouched.
  load: (data: string) -> boolean,
  -- True when a replay is loaded.
  loaded: () -> boolean,
  unload: () -> (),
  -- Why the last `load` failed, or \"\" after a success.
  last_error: () -> string,
  -- The loaded replay's section count.
  loaded_sections: () -> number,
  -- The loaded replay's first and last tick, or 0 when none.
  loaded_first_tick: () -> number,
  loaded_last_tick: () -> number,
  -- How many entities the reconstructed world holds at `tick`, or 0 when no replay is loaded.
  world_entity_count: (tick: number) -> number,
  -- The entity at `index` of the reconstructed world at `tick` as {valid, id, type, x, y, z, health, max_health, alive, name}, or an empty table when out of range.
  world_entity: (tick: number, index: number) -> {[string]: any},
  -- The block id at a block coordinate in the reconstructed world at `tick`, or 0 when no replay is loaded.
  world_block: (tick: number, x: number, y: number, z: number) -> number,
  -- The replay's tick range as {first, last}, or zeros when none.
  tick_range: () -> {[string]: any},
  -- Turns the local review overlay on or off. Off by default.
  set_review_active: (on: boolean) -> (),
  review_active: () -> boolean,
  -- Starts the review playback from the loaded replay. False when no replay is loaded.
  review_play: () -> boolean,
  review_pause: () -> (),
  review_playing: () -> boolean,
  -- The tick the review is showing.
  review_tick: () -> number,
  -- Moves the review to a tick. False when no replay is loaded.
  review_seek: (tick: number) -> boolean,
  -- The playback speed multiplier. Must be finite and in (0, 64]; a bad value is refused.
  review_speed: () -> number,
  set_review_speed: (speed: number) -> boolean,
  -- Draws the review through the frame's renderer when active; returns how many entities it drew. A no-op (0) when inactive or no replay is loaded.
  review_present: () -> number,
  -- Binds the loopback playback server to `host:port`. `host` must be a loopback address (\"127.0.0.1\", \"::1\" or \"localhost\"); anything else is refused. A port of 0 asks the OS for a free one, which `server_port` reports. Returns false (with a reason in `last_error`) when the host is not loopback, the socket cannot bind, or the server is already running.
  server_start: (host: string, port: number) -> boolean,
  server_stop: () -> (),
  server_running: () -> boolean,
  server_port: () -> number,
  server_client_connected: () -> boolean,
  -- How many packets the server has sent since a client joined.
  server_packets_sent: () -> number,
  -- Pauses or resumes the server's stream (the client stays connected).
  server_set_paused: (paused: boolean) -> (),
  server_paused: () -> boolean,
  -- Restarts the stream for the connected client at the nearest keyframe at or before `tick`. False when no client is connected.
  server_seek: (tick: number) -> boolean,
  -- A one-line status: capture state, sections, bytes, whether a replay is loaded, and whether a client is connected.
  status: () -> string,
}

export type AsyncFacade = {
  wait: (ticks: number) -> ((),
  eventsOnce: (channel: string) -> (unknown,
  httpGet: (url: string, timeoutMs: number?) -> (string,
}
